# Copiar este archivo como .env y completar los valores

# Clave secreta para sesiones Flask (cambiala por algo aleatorio)
SECRET_KEY=cambiar-por-clave-segura-aleatoria

# Credenciales del admin (unico usuario del sistema)
ADMIN_USER=admin
ADMIN_PASS=tu_contrasena_aqui

# API de Groq (obtener en console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
# Modelo para tareas cortas (huéspedes, reseñas, resúmenes). Tiene su propio cupo diario en Groq.
GROQ_MODEL_RAPIDO=openai/gpt-oss-20b

# URL de conexion a PostgreSQL (Render la provee automaticamente como variable de entorno)
DATABASE_URL=postgresql://user:pass@host/dbname

# Búsqueda de competencia con IA (competencia_ia.py)
# Modelo de Groq con búsqueda web incorporada
GROQ_SEARCH_MODEL=openai/gpt-oss-120b
# Opcional: dólar para convertir anuncios publicados en USD a ARS (ej: 1400). Vacío = se descartan.
TIPO_CAMBIO_USD=

# ### CAMBIO AQUÍ ### — Búsqueda de competencia con Tavily (tavily.com, 1.000 créditos gratis por mes)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
# Búsquedas de Tavily por zona (1 crédito cada una)
TAVILY_MAX_BUSQUEDAS=2
# Si Tavily no encuentra suficientes anuncios, usar la búsqueda web de Groq (gasta mucho cupo). 1 = sí, 0 = no
COMPETENCIA_RESPALDO_GROQ=1

# Actualización automática nocturna: clave secreta que usa cron-job.org para llamar a
# https://TU-APP.onrender.com/tareas/competencia?token=ESTA_CLAVE
TAREAS_TOKEN=inventar-una-clave-larga-y-secreta
# Máximo de zonas (barrio + ambientes) a actualizar por noche
MAX_GRUPOS_POR_NOCHE=10
